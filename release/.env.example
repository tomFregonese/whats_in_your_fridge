# Technical settings only — no user secrets belong here.
#
# The OpenRouter token, the chosen model, allergies, portions, etc. are all
# configured from the app's own UI on first launch (see README.txt) — there
# is nothing else to fill in below before running run.sh / run.command / run.bat.

# How many past meals are injected into the LLM's context to avoid repeats.
HISTORY_WINDOW_N=10

# Local port the app is served on (http://127.0.0.1:<APP_PORT>).
APP_PORT=8080

# Which published version to run. Leave unset to always track the latest
# release; set to a specific tag (e.g. APP_VERSION=v0.1.0) to pin one.
# APP_VERSION=latest
